# Optional fixed public URL for invite links and QR codes. Leave empty to use the address
# each request arrives on (works with a changing cloudflared quick-tunnel URL).
NEXT_PUBLIC_APP_URL=
# Never true for real reports: allows picking a file instead of the live camera.
NEXT_PUBLIC_ALLOW_DEV_UPLOAD=false
# Optional: folder for the SQLite DB and photos (default: web/data).
MOVEPROOF_DATA_DIR=
# Email login codes via Gmail: SMTP_USER = your Gmail address, SMTP_PASS = a 16-character
# App Password (Google Account → Security → 2-Step Verification → App passwords). Leave empty
# to print codes in the server console instead.
SMTP_USER=
SMTP_PASS=
